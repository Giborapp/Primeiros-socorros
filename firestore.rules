rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function ownsSchool(schoolId) {
      return request.auth != null && request.auth.uid == schoolId;
    }

    // User profile: only the authenticated owner.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // School document: only the account that owns it.
    match /schools/{schoolId} {
      allow read, write: if ownsSchool(schoolId);

      // Temporarily open while the public launch flow is validated.
      match /students/{studentId} {
        allow read, write: if true;
      }
    }

    // Temporary read-only access used to migrate the old root collection.
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Temporarily open while the public launch flow is validated.
    match /results/{resultId} {
      allow read, write: if true;
    }
  }
}
